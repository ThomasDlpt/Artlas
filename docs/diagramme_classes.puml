@startuml diagramme_classes
' Diagramme de classes Artlas (transcription de docs/diagramme_classes.png)
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
hide empty members

' ======================= Circuits =======================
package "Circuits" {
  class Circuit {
    + {static} VITESSE_MARCHE_KMH : double = 5.0
    + {static} NB_ETAPES_MIN : int = 2
    - {static} ALPHABET_CODE : String = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
    - {static} LONGUEUR_CODE : int = 8
    - {static} RANDOM : SecureRandom = new SecureRandom()
    - id : String
    - nom : String
    - description : String
    - codePartage : String
    - distanceKm : double
    - dureeMinutes : int
    - etapes : List<EtapeCircuit>
    - communeDepart : Commune
    + getId() : String
    + getNom() : String
    + setNom(String nom) : void
    + getDescription() : String
    + setDescription(String description) : void
    + getCodePartage() : String
    + getDistanceKm() : double
    + getDureeMinutes() : int
    + getEtapes() : List<EtapeCircuit>
    + getNbEtapes() : int
    + getCommuneDepart() : Commune
    + ajouterEtape(lieu : Lieu, dureeVisiteMin : int) : void
    + retirerEtape(position : int) : void
    + reordonner(position : int, nouvellePosition : int) : void
    + recalculer() : void
    + estValide() : boolean
    + contientLieu(lieu : Lieu) : boolean
    - verifierPosition(position : int) : void
    - renumeroter() : void
    - genererCodePartage() : String
  }

  class EtapeCircuit {
    - numOrdre : int
    - dureeVisiteMin : int
    - lieu : Lieu
    + getNumOrdre() : int
    + getDureeVisiteMin() : int
    + getLieu() : Lieu
    + setNumOrdre(numOrdre : int) : void
  }
}

' ======================= Consultation =======================
package "Consultation" {
  class LieuService {
    + rechercher(filtre : FiltreRecherche) : List<Lieu>
    + rechercherDansZone(zone : BBox, filtre : FiltreRecherche) : List<Lieu>
    + selectionner(idLieu : String) : Lieu
  }
}

' ======================= Lieux =======================
package "Lieux" {
  class Lieu {
    - id : String
    - nom : String
    - description : String [0..1]
    - type : TypeLieu
    - siteWeb : String [0..1]
    - photo : String [0..1]
    - labels : List<String>
    - adresse : Adresse
    - dateMiseAJour : LocalDate
    + getId() : String
    + getNom() : String
    + getDescription() : String
    + getType() : TypeLieu
    + getSiteWeb() : String
    + getPhoto() : String
    + getLabels() : List<String>
    + getAdresse() : Adresse
    + getDateMiseAJour() : LocalDate
    + distanceVers(autre : Lieu) : double
    + mettreAJour(donnees : Lieu) : void
    + {static} estRenseigne(valeur : String) : boolean
    + {static}normaliser((valeur : String) : String
  }

  class LieuBasilic {
    + LieuBasilic()
    + LieuBasilic(id : String, nom : String, description : String, type : TypeLieu, siteWeb : String, photo : String, labels : List<String>, dateMiseAJour : LocalDate, adresse : Adresse)
  }

  class LieuDataTourisme {
    + LieuDataTourisme()
    + LieuDataTourisme(id : String, nom : String, description : String, type : TypeLieu, siteWeb : String, photo : String, labels : List<String>, dateMiseAJour : LocalDate, adresse : Adresse)
  }

  enum TypeLieu {
    MUSEE
    MONUMENT
    LIEU_EXPOSITION
    THEATRE
    CINEMA
    BIBLIOTHEQUE
    AUTRE
  }

  enum Source {
    BASILIC
    DATATOURISME
  }
}

' ======================= Géographie =======================
package "Géographie" {
  class Adresse {
    - {static} RAYON_TERRE_KM : double = 6371.0
    - rue : String
    - codePostal : String
    - latitude : double
    - longitude : double
    - commune : Commune
    + getRue() : String
    + getCodePostal() : String
    + getLatitude() : double
    + getLongitude() : double
    + getCommune() : Commune
    + distanceKm(autre : Adresse) : double
    + toString() : String
  }

  class Commune {
    - codeInsee : String
    - nom : String
    - departement : Departement
    + getCodeInsee() : String
    + getNom() : String
    + getDepartement() : Departement
    + setDepartement(departement : Departement) : void
    + equals(o : Object) : boolean
    + hashcode() : int
    + toString() : String
  }

  class Departement {
    - code : String
    - nom : String
    - region : Region
     + getCode() : String
     + getNom() : String
     + getRegion() : Region
     + equals(o : Object) : boolean
     + hashcode() : int
     + toString() : String
  }

  class Region {
    - code : String
    - nom : String
    + getCode() : String
    + getNom() : String
    + equals(o : Object) : boolean
    + hashcode() : int
    + toString() : String
  }
}

' ======================= Synchronisation =======================
package "Synchronisation" {
  class SynchronisationService {
    - importeurDataTourism : Importeur
    - importeurBasilic : Importeur
    - repo : JournalSynchroRepository
    - lieuRepo : LieuRepository
    + synchroniser() : List<JournalSynchro>
    + synchroniserSource(importeur : Importeur) : JournalSynchro
    - fusionner(existant : Lieu, nouveau : Lieu) : void
    - trouverExistant(repoSource : LieuRepository, l : Lieu) : Lieu
  }

  interface Importeur {
    + getSource() : Source
    + importer() : ResultatImport
  }

  class ImporteurDataTourisme {
    - REQUETE : String
    - client : RestClient
    - repo : CommuneRepository
    + getSource() : Source
    + importer() : ResultatImport
    - convertirCategories(categories : List<String>) : TypeLieu
  }

  class ImporteurBasilic {
    - REQUETE : String
    - client : RestClient
    - repo : CommuneRepository
    + getSource() : Source
    + importer() : ResultatImport
    - convertirType(types : String) : TypeLieu
  }

  class ResultatImport {
    - source : Source
    - nbLignesLues : int
    - erreurs : List<String>
    - lieux : List<Lieu>
    + getSource() : Source
    + getNbLignesLues() : int
    + getErrors() : List<String>
    + getLieux() : List<Lieu>
  }

  class JournalSynchro {
    - id : String
    - source : Source
    - dateSynchro : LocalDateTime
    - nbAjouts : int
    - nbLignesLues : int
    - nbRejets : int
    - statut : StatutSynchro
    - erreurs : List<String>
    + getId() : String
    + getSource() : Source
    + getDateSynchro() : LocalDateTime
    + getNbAjouts() : int
    + getNbRejets() : int
    + getNbLignesLues() : int
    + getStatut() : StatutSynchro
    + getErreurs() : List<String>

  }

  enum StatutSynchro {
    SUCCES
    PARTIEL
    ECHEC
  }
}

' ======================= Accès aux données =======================
package "Accès aux données" {
  interface CommuneRepository {
    + trouverParCodeInsee(codeInsee : String) : Commune
    + trouverParCodePostalEtNom(codePostal : String, nom : String) : Commune
    + renvoieOuCreeCommune(codeInsee : String, nom : String) : Commune
    + tailleRepo() : int
  }

  interface LieuRepository {
    + enregistrer(lieu : Lieu) : void
    + trouverParId(id : String) : Lieu
    + trouverParDepartement(code : String) : List<Lieu>
    + trouverParType(type : TypeLieu) : List<Lieu>
    + trouverDansZone(zone : BBox, filtre : FiltreRecherche) : List<Lieu>
    + trouverParFiltre(filtre : FiltreRecherche) : List<Lieu>
    + filtreOk(lieu : Lieu, filtre : FiltreRecherche ) : boolean
    - codeDepartement(lieu : Lieu) : String
    + trouverProche(latitude : double, longitude : double, rayon : double, filtre : FiltreRecherche) : List<Lieu>
    + calculDistance (lat1 : double, lon1 : double, lat2 : double, lon2 : double) : double
  }

  interface CircuitRepository {
    + enregistrer(circuit : Circuit) : void
    + supprimer(circuit : Circuit) : void
    + trouverParCodePartage(code : String) : Circuit
    + trouverParDepartement(code : String) : List<Circuit>
  }

  interface JournalSynchroRepository {
    + enregistrer(journal : JournalSynchro) : void
    + trouverDernier(source : Source) : JournalSynchro
  }
}

' ======================= Recherche =======================
package "Recherche" {
  class FiltreRecherche {
    - types : List<TypeLieu>
    - codeDepartement : String
    - label : String
    - texte : String
    + getTypes() : List<TypeLieu>
    + getCodeDepartement() : String
    + getLabel() : String
    + getTexte() : String
  }

  class BBox {
    - latMin : double
    - latMax : double
    - lonMin : double
    - lonMax : double
    + contient(lat : double, lon : double) : boolean
    + getLatMin() : double
    + getLatMax() : double
    + getLonMin() : double
    + getLonMax() : double
  }
}

' ======================= Relations =======================

' Circuits
Circuit "1" *-- "2..*" EtapeCircuit
EtapeCircuit "*" --> "1" Lieu
Circuit "*" --> "1" Commune : +communeDepart

' Lieux
Lieu "1" *-- "1" Adresse
Lieu <|-- LieuBasilic
Lieu <|-- LieuDataTourisme

' Géographie
Adresse "*" --> "1" Commune
Departement "1" *-- "1..*" Commune
Region "1" *-- "1..*" Departement

' Consultation
LieuService ..> Lieu
LieuService --> LieuRepository

' Synchronisation
SynchronisationService "1" --> "1..*" Importeur : importeurs
SynchronisationService ..> JournalSynchro : <<create>>
SynchronisationService --> LieuRepository
SynchronisationService --> JournalSynchroRepository
Importeur <|.. ImporteurDataTourisme
Importeur <|.. ImporteurBasilic
Importeur ..> ResultatImport : <<create>>
ResultatImport "1" --> "*" Lieu : lieux
ImporteurDataTourisme ..> CommuneRepository
ImporteurBasilic ..> CommuneRepository

' Accès aux données -> Recherche
LieuRepository ..> FiltreRecherche
LieuRepository ..> BBox

@enduml
